{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://misskey.io/schemas/ChatMessageLiteForRoom",
  "title": "ChatMessageLiteForRoom",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "fromUserId": {
      "type": "string"
    },
    "fromUser": {
      "type": "object",
      "$ref": "#/components/schemas/UserLite"
    },
    "toRoomId": {
      "type": "string"
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "fileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "file": {
      "type": [
        "object",
        "null"
      ],
      "anyOf": [
        {
          "$ref": "#/components/schemas/DriveFile"
        },
        {
          "type": "null"
        }
      ]
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reaction": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "$ref": "#/components/schemas/UserLite"
          }
        },
        "required": [
          "reaction",
          "user"
        ]
      }
    }
  },
  "required": [
    "id",
    "createdAt",
    "fromUserId",
    "fromUser",
    "toRoomId",
    "reactions"
  ]
}