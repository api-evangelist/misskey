{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://misskey.io/schemas/Signin",
  "title": "Signin",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "ip": {
      "type": "string"
    },
    "headers": {
      "type": "object"
    },
    "success": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "createdAt",
    "ip",
    "headers",
    "success"
  ]
}