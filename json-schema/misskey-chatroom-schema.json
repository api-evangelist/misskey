{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://misskey.io/schemas/ChatRoom",
  "title": "ChatRoom",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "ownerId": {
      "type": "string"
    },
    "owner": {
      "type": "object",
      "$ref": "#/components/schemas/UserLite"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "isMuted": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "createdAt",
    "ownerId",
    "owner",
    "name",
    "description"
  ]
}